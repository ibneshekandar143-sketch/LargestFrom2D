package com.arrays;

public class LargestFrom2D {
    public static void main(String[] args) {
        int [][] numbers={
                {23,34,65},
                {43,64,75},
                {92,94,21}
        };
        int max = numbers[0][0];
        for (int[] row: numbers) {
            for (int col : row){
                if (col > max){
                    max = col;
                }
            }

        }
        System.out.println("\nMaximum number is: "+ max);
    }
}
